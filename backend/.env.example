# Mẫu biến môi trường. Copy thành `.env` rồi điền giá trị thật:
#
#     cp .env.example .env
#
# File `.env` đã nằm trong .gitignore — KHÔNG commit nó.

# ---------------------------------------------------------------------------
# Dùng cho docker compose (docker-compose.yml đọc file .env cùng thư mục)
# ---------------------------------------------------------------------------

# Mật khẩu tài khoản root của MySQL container
MYSQL_ROOT_PASSWORD=

# Mật khẩu tài khoản ứng dụng (user mặc định: mediq)
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# Dùng khi chạy service bằng Maven (Spring Boot đọc từ biến môi trường)
# ---------------------------------------------------------------------------

# Bắt buộc — service sẽ không khởi động nếu thiếu
DB_PASSWORD=

# Tuỳ chọn — đã có giá trị mặc định, chỉ set khi cần override
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=mediq

# ---------------------------------------------------------------------------
# Lưu ý: nếu chỉ muốn chạy thử ở local mà không cần MySQL, dùng profile `local`
# (H2 in-memory, không cần biến môi trường nào):
#
#     ./mvnw spring-boot:run -pl doctor-service -Dspring-boot.run.profiles=local
# ---------------------------------------------------------------------------
